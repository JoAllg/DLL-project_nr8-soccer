# =========================
# Local environment variables for HPC deployment
# Sourced by deploy.sh
# Copy as ".env" and replace <placeholders>

# SSH connection to BwUniCluster 3.0
HPC_USER="fr_<uni-freiburg-id or user>"
HPC_HOST="uc3.scc.kit.edu"
# Single key: HPC_IDENTITY="~/.ssh/<ssh-key>"
# Multiple keys: HPC_IDENTITY=("~/.ssh/<ssh-key-1>" "~/.ssh/<ssh-key-2>")
HPC_IDENTITY="~/.ssh/<ssh-key>"

# SSH connection to the Uni Freiburg login node (jump host to reach BwUniCluster)
JUMPHOST_USER="<tf-user>"
JUMPHOST_HOST="login.informatik.uni-freiburg.de"
# Single key: JUMPHOST_IDENTITY="~/.ssh/<ssh-key>"
# Multiple keys: JUMPHOST_IDENTITY=("~/.ssh/<ssh-key>" "~/.ssh/<ssh-key>_backup")
JUMPHOST_IDENTITY="~/.ssh/<ssh-key>"

# Remote paths
REMOTE_SCRIPTS_DIR="~/hpc-scripts"