# Local environment variables for HPC deployment
# Sourced by deploy.sh
# Copy as ".env" and replace <placeholders>

# SSH connection to BwUniCluster 3.0
HPC_USER="fr_<uni-freiburg-id or user>"
HPC_HOST="uc3.scc.kit.edu"
HPC_IDENTITY="~/.ssh/<ssh-key>"

# Remote paths
REMOTE_SCRIPTS_DIR="~/hpc-scripts"

# Project config (repository, workspace) is in .env.remote
