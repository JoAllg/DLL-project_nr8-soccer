# Local environment variables for HPC deployment
# Sourced by deploy.sh
# Copy as ".env" and replace <placeholders>

# SSH connection to BwUniCluster 3.0
HPC_USER="fr_<uni-freiburg-id or user>"
HPC_HOST="uc3.scc.kit.edu"
HPC_IDENTITY="~/.ssh/<ssh-key>"

# Remote paths
REMOTE_SCRIPTS_DIR="~/hpc-scripts"

# Repository (SSH clone via deploy key)
REPO_URL="git@github.com:JoAllg/DLL-project_nr8-soccer.git"
REPO_NAME="DLL-project_nr8-soccer"
BRANCH="main"

# Workspace (on Lustre, better I/O than $HOME)
WORKSPACE_NAME="data"
WORKSPACE_DAYS=60
WORKSPACE_EMAIL="<user>@tf.uni-freiburg.de"
