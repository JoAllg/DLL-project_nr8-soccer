### BwUniCluster 3.0

# Show available resources and queued jobs
Host hpc.sinfo
  RequestTTY yes
  RemoteCommand {{REMOTE_SCRIPTS_DIR}}/sinfo.sh

# Interactively reserve compute nodes (runs inside tmux)
Host hpc.salloc
  RequestTTY yes
  RemoteCommand {{REMOTE_SCRIPTS_DIR}}/salloc.sh

# Run JOB_CMD on an running node
Host hpc.srun
  RequestTTY yes
  RemoteCommand {{REMOTE_SCRIPTS_DIR}}/srun.sh

# Open a shell on a running node
Host hpc.login
  RequestTTY yes
  RemoteCommand {{REMOTE_SCRIPTS_DIR}}/login.sh

# Cancel a job
Host hpc.scancel
  RequestTTY yes
  RemoteCommand {{REMOTE_SCRIPTS_DIR}}/scancel.sh

# Submit a batch job running JOB_CMD
Host hpc.sbatch
  RequestTTY yes
  RemoteCommand {{REMOTE_SCRIPTS_DIR}}/sbatch.sh

# Show details of a job
Host hpc.scontrol
  RequestTTY yes
  RemoteCommand {{REMOTE_SCRIPTS_DIR}}/scontrol.sh

# Show the log of a recent job (less if finished, less +F if still running)
Host hpc.logs
  RequestTTY yes
  RemoteCommand {{REMOTE_SCRIPTS_DIR}}/logs.sh

# Start a VS Code / Cursor remote tunnel on a running job
Host hpc.tunnel
  RequestTTY yes
  RemoteCommand {{REMOTE_SCRIPTS_DIR}}/code_tunnel.sh

