# =========================
# bwHPC deployment and Slurm scripts (2026)
# Joshua Allgeier <allgeier@informatik.uni-freiburg.de>
# =========================
# Remote environment variables for HPC
# Sourced from .bashrc — deployed by deploy.sh

# Project
export WORKSPACE_NAME="data"
WORKSPACE="$(ws_find "$WORKSPACE_NAME" 2>/dev/null)"
export WORKSPACE

export REPO_NAME="DLL-project_nr8-soccer"
export REPO_URL="git@github.com:JoAllg/DLL-project_nr8-soccer.git"
export REPO_DIR="$WORKSPACE/$REPO_NAME"

export SCRIPTS_DIR="$HOME/hpc-scripts"

export JOB_CMD="uv run python main.py"

export UV_LINK_MODE=copy  # UV can not hardlink libraries if cache and environment are on different drives. Use copy instead

# Aliases
alias smi='nvidia-smi'
alias idle="sinfo_t_idle"
alias sqs="squeue --start && squeue -l"
alias sc="scancel -t \"RUNNING\""
alias wsqs="watch -c -n 0.5 \"squeue --start && squeue -l\""

##### General Linux settings

## set up default editor (currently nano)
export EDITOR=nano

## set up less as default pager (is this still neccessary on current Linux systems?)
export PAGER=less

## enable verbosity and interactive confirmation on rp, cp, mv
## to help protect newbies from themselves...
alias rm="rm -vi"
alias cp="cp -vi"
alias mv="mv -vi"

## force verbose mode on mcopy (probably long since obsolete but harmless)
alias mcopy="mcopy -v"

# set up a primary prompt showing username, hostname and cwd
PS1='[\u@\h \W]\$ '
PS2='> '
PS3='> '
PS4='+ '

# Navigation aliases
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# File operations
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias grep='grep --color=auto'

# System operations
alias update='sudo apt update && sudo apt upgrade'
alias install='sudo apt install'
alias remove='sudo apt remove'
alias search='apt search'
alias info='apt show'

# Git shortcuts
alias gs='git status'
alias ga='git add'
alias gc='git commit' # Usage gc -m "Initial commit"
# You would still need to write -m "Commit message"
# My choice is to write function like this 
# gc() { git commit -m "$1" } and now just gc "Initial commit"
alias gp='git push'
alias gl='git log --oneline'

# Network
alias ping='ping -c 5'
alias ports='netstat -tulanp'

# Disk usage
alias df='df -H'
alias du='du -ch'

# Process management
alias ps='ps auxf'
alias psg='ps aux | grep -v grep | grep -i -E'
