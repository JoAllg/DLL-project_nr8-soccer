diff --git a/hpc-scripts/logs.sh b/hpc-scripts/logs.sh
new file mode 100755
index 0000000..465dbb4
--- /dev/null
+++ b/hpc-scripts/logs.sh
@@ -0,0 +1,54 @@
+#!/bin/bash
+# =========================
+# bwHPC deployment and Slurm scripts (2026)
+# Joshua Allgeier <allgeier@informatik.uni-freiburg.de>
+# =========================
+source "$HOME/hpc-scripts/.env.remote" 2>/dev/null
+
+echo "### Your recent jobs:"
+mapfile -t JOB_LINES < <(sacct -u "$USER" -X -n -P -S "$(date -d '30 days ago' +%Y-%m-%d)" \
+    -o JobID,JobName,Partition,State,Start,NodeList | tac | head -n 15)
+
+if [ ${#JOB_LINES[@]} -eq 0 ]; then
+    echo "No jobs found."
+    exec bash -i
+fi
+
+JOBS=()
+printf "  #)  %-10s %-20s %-12s %-12s %-19s %s\n" "JOBID" "NAME" "PARTITION" "STATE" "START" "NODELIST"
+for i in "${!JOB_LINES[@]}"; do
+    IFS='|' read -r id name part state start nodelist <<< "${JOB_LINES[$i]}"
+    JOBS+=("$id")
+    printf "  %d)  %-10s %-20s %-12s %-12s %-19s %s\n" $((i+1)) "$id" "$name" "$part" "$state" "$start" "$nodelist"
+done
+
+echo ""
+read -p "Select job [1]: " SEL
+SEL=${SEL:-1}
+JOBID=${JOBS[$((SEL-1))]}
+
+STATE=$(sacct -j "$JOBID" -X -n -o State | awk '{print $1}')
+LOGFILE="$LOG_DIR/slurm-$JOBID.out"
+
+case "$STATE" in
+    RUNNING|COMPLETING)
+        if [ -f "$LOGFILE" ]; then
+            echo "### Following live log for job $JOBID (Ctrl+C to stop following, F to resume, q to quit)..."
+            less +F "$LOGFILE"
+        else
+            echo "Log file not found yet at $LOGFILE"
+        fi
+        ;;
+    PENDING)
+        echo "Job $JOBID has not started yet — no log available."
+        ;;
+    *)
+        if [ -f "$LOGFILE" ]; then
+            less "$LOGFILE"
+        else
+            echo "No log captured for job $JOBID at $LOGFILE."
+            echo "(Only jobs submitted via hpc.sbatch write a log file; interactive"
+            echo " hpc.srun/hpc.salloc/hpc.login sessions print straight to the terminal.)"
+        fi
+        ;;
+esac
diff --git a/hpc-scripts/run.job.template b/hpc-scripts/run.job.template
index a5c5c84..7e8ffdb 100644
--- a/hpc-scripts/run.job.template
+++ b/hpc-scripts/run.job.template
@@ -13,16 +13,29 @@
 #SBATCH --job-name=${JOBNAME}
 #SBATCH --time=${TIME}
 #SBATCH --chdir=${REPO_DIR}
+#SBATCH --output=${LOG_DIR}/slurm-%j.out
 ${RESOURCE_DIRECTIVES}
 ${MAIL_DIRECTIVES}
 
 source "$HOME/hpc-scripts/.env.remote"
 cd "$REPO_DIR" || exit 1
 
-# 1. Get the requested code (branch chosen interactively)
-echo "### Checking out branch '${BRANCH}'..."
-git checkout "${BRANCH}"
-git pull
+# 1. Run from a private git worktree so concurrent jobs never race on $REPO_DIR's
+# working tree/index, and stray local state can never block the checkout. The
+# worktree tracks origin/${BRANCH} *detached* rather than checking out "${BRANCH}"
+# by name — git refuses to check out a branch that's already checked out in
+# another worktree of the same repo, and $REPO_DIR itself flips between
+# "${BRANCH}" and a runs/<date>+<node> branch across the run lifecycle. Fetching
+# then checking out origin/${BRANCH}'s tip into a brand-new directory already is
+# the "force checkout, then pull" — there's no local state left to conflict with.
+RUN_DIR="$WORKSPACE/job-runs/${SLURM_JOB_ID}"
+mkdir -p "$(dirname "$RUN_DIR")"
+git worktree prune
+echo "### Fetching '${BRANCH}' and checking out a private worktree..."
+git fetch origin "${BRANCH}"
+git worktree add --detach "$RUN_DIR" "origin/${BRANCH}"
+cd "$RUN_DIR" || exit 1
+trap 'cd "$REPO_DIR" 2>/dev/null; git worktree remove --force "$RUN_DIR" 2>/dev/null' EXIT
 
 # 2. Sync the environment (nodes have internet)
 echo "### Syncing uv environment..."
@@ -38,7 +51,16 @@ NODE="${SLURMD_NODENAME:-$(hostname -s)}"
 DATE="$(date +%Y-%m-%d)"
 RUN_BRANCH="runs/${DATE}+${NODE}"
 echo "### Archiving run to branch '$RUN_BRANCH' (command exit ${RUN_STATUS})..."
+# The live log lives in $LOG_DIR (persists across branch checkouts); copy it into
+# the worktree too so this run's branch carries its own log. Also pull in
+# run.sbatch itself (this script, at $0) since it lives in $REPO_DIR, not in this
+# worktree, and wouldn't otherwise be picked up by `git add -A` below.
+cp "$LOG_DIR/slurm-${SLURM_JOB_ID}.out" . 2>/dev/null || true
+cp "$0" ./run.sbatch 2>/dev/null || true
 git checkout -B "$RUN_BRANCH"
 git add -A
 git commit -m "run on ${NODE} ${DATE} (exit ${RUN_STATUS}); see run.sbatch for the command" || true
 git push -u origin "$RUN_BRANCH"
+
+# 5. Clean up the private worktree (handled by the EXIT trap set in step 1, which
+# fires here on normal exit too).
